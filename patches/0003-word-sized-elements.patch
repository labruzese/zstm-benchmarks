# Parameterize the microbenchmark element type. RSTM's benches store 'int', which on x86-64 goes through the sub-word DISPATCH<T,4> path: a masked read-modify-write logged at word granularity, so adjacent elements falsely conflict. zstm's TxWord is a native usize. -Dbench_word_elements=ON switches to intptr_t for an apples-to-apples comparison; the default keeps stock behavior.
#
# (new file: bench/bench_elem.hpp)
--- /dev/null
+++ b/bench/bench_elem.hpp
@@ -0,0 +1,30 @@
+/**
+ *  BENCHMARK PATCH -- not part of upstream RSTM v7.
+ *
+ *  The array/counter microbenchmarks store `int` (4 bytes). On x86-64 that is a
+ *  sub-word access, so RSTM's library API routes it through the
+ *  `DISPATCH<T,4>` specialization in include/api/library_inst.hpp: a masked
+ *  read-modify-write, logged at 8-byte word granularity. Two adjacent elements
+ *  therefore share one log entry and conflict with each other even when the
+ *  program touches distinct indices.
+ *
+ *  zstm's TxWord is a native usize, so it has no equivalent behavior. Comparing
+ *  the two as-is would measure RSTM's sub-word dispatch, not the NOrec
+ *  implementations.
+ *
+ *  Parameterizing the element type lets us build both:
+ *
+ *    - default (`int`)                : stock RSTM, kept as the reference point
+ *    - -DBENCH_ELEM_T=intptr_t        : word-sized, apples-to-apples with zstm
+ */
+
+#ifndef BENCH_ELEM_HPP__
+#define BENCH_ELEM_HPP__
+
+#include <stdint.h>
+
+#ifndef BENCH_ELEM_T
+#define BENCH_ELEM_T int
+#endif
+
+#endif // BENCH_ELEM_HPP__
--- a/bench/CMakeLists.txt
+++ b/bench/CMakeLists.txt
@@ -36,6 +36,18 @@
 
 append_cxx_flags(${CMAKE_THREAD_INCLUDE})
 
+# BENCHMARK PATCH: widen the microbenchmark element type from `int` to a machine
+# word, so the array benchmarks compare like-for-like against an STM whose
+# native granularity is pointer-sized. See bench/bench_elem.hpp for why this
+# matters. Done as an option rather than via -DCMAKE_CXX_FLAGS on the command
+# line, because setting that variable would clobber the architecture and
+# optimization flags RSTM configures in cmake/UserOverrides.cmake.
+option(bench_word_elements
+  "Use intptr_t rather than int as the microbenchmark element type." OFF)
+if (bench_word_elements)
+  add_definitions(-DBENCH_ELEM_T=intptr_t)
+endif ()
+
 # Build the STM executables.
 if (bench_enable_multi_source)
   foreach (bench ${benchmarks})
